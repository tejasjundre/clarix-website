PORT=3000
FORM_TO_EMAIL=contact@clarixdigitech.com

# SMTP setup for direct email notifications from website enquiries
# Example providers: Zoho Mail, Google Workspace, Hostinger, SendGrid SMTP
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@clarixdigitech.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=Clarix Digitech <your-email@clarixdigitech.com>
